# ==== Тип API: OPEN_AI, DEEPSEEK или OLLAMA ====
USE_API_TYPE=OPEN_AI

# ==== OpenAI / OpenAI-совместимые эндпоинты (используется при USE_API_TYPE=OPEN_AI) ====
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODEL=gpt-4o-mini

# ==== DeepSeek (используется при USE_API_TYPE=DEEPSEEK) ====
# DeepSeek API полностью совместим с OpenAI по формату запросов
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_MODEL=deepseek-chat

# ==== Ollama (используется при USE_API_TYPE=OLLAMA) ====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
